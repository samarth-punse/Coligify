<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_delete_dialog">

    <!-- APP LOGO -->
    <ImageView
        android:id="@+id/ivimglogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/coligify_logo"/>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Coligify 🎓"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#2F6F73"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"/>

    <!-- MESSAGE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find colleges, explore content, and get AI guidance."
        android:textSize="13sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginTop="6dp"/>

    <!-- BUTTON -->
    <Button
        android:id="@+id/btnWelcome"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#2F6F73"
        android:layout_marginTop="16dp"/>

</LinearLayout>
