<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/profileImg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_samarth"
                    android:background="@drawable/circle_bg"
                    android:padding="4dp" />

                <ImageView
                    android:id="@+id/notificationIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/notifications_icon"
                    app:tint="#010042" />
            </RelativeLayout>

            <!-- Greeting -->
            <TextView
                android:layout_marginTop="14dp"
                android:text="Hey Sahil 👋"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#010042"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Banner with Image Slider + Overlay -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Overlay Content -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:background="#7B2CBF">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:weightSum="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="0.3"
                                android:text="Get Java Courses"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="0.3"
                                android:fontFamily="sans-serif"
                                android:text="Online courses from experts"
                                android:textColor="@android:color/white"
                                android:textSize="15sp"/>

                            <Button
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="0.4"
                                android:text="Get Started"
                                android:textAllCaps="false"
                                android:textSize="15sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#FF9F59"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/itr_training"
                            android:scaleType="fitCenter"/>
                    </RelativeLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- Year Filter -->
            <HorizontalScrollView
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/firstYear"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center"
                        android:text="1st Year"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/chip_selected"
                        android:layout_width="wrap_content"/>

                    <TextView
                        android:id="@+id/secondYear"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center"
                        android:text="2nd Year"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/chip_unselected"
                        android:layout_width="wrap_content"/>

                    <TextView
                        android:id="@+id/thirdYear"
                        android:layout_height="40dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center"
                        android:text="3rd Year"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/chip_unselected"
                        android:layout_width="wrap_content"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Recently Added -->
            <TextView
                android:layout_marginTop="20dp"
                android:text="Recently Added"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#010042"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <!-- Subject Cards -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2">

                <!-- Card 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSft"
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:layout_marginLeft="@dimen/cardview_compat_inset_shadow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- IMAGE + PRICE BADGE -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.3">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/itr_training"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/red_price_bg"
                                android:text="₹29"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.7"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SFT Ch-1"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="4.7 ★ | 12k students"
                                android:textSize="12sp"
                                android:textColor="#777777" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardJava"
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- IMAGE + PRICE BADGE -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.3">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/itr_training"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/red_price_bg"
                                android:text="₹49"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.7"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Java Ch-1"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="4.6 ★ | 10k students"
                                android:textSize="12sp"
                                android:textColor="#777777" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
