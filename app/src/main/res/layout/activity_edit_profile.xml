<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#6A5AE0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Back -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textSize="25sp"
            android:textColor="@color/white"
            android:fontFamily="@font/agbalumo"
            app:layout_constraintTop_toTopOf="@id/ivBack"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Save -->
        <ImageView
            android:id="@+id/ivSave"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <FrameLayout
            android:id="@+id/profileLayout"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_profile"
                android:id="@+id/civprofile"
                android:scaleType="centerCrop"
                app:civ_border_width="3dp"
                app:civ_border_color="#4CAF50" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:id="@+id/ivcamera"
                android:layout_gravity="bottom|end"
                app:tint="@color/white"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/circle_bg"
                android:padding="5dp"
                android:src="@drawable/ic_camera" />
        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_glass"
            app:layout_constraintTop_toBottomOf="@id/profileLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">



            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/actor"
                android:inputType="textMultiLine"
                android:minWidth="48dp"
                android:text="Name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileLayout" />

            <EditText
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:hint="Enter Name"
                android:id="@+id/etprofilename"
                android:inputType="textMultiLine"
                android:background="@drawable/edit_bg"
                android:textColor="@color/white"
                android:textColorHint="#BFFFFFFF"
                android:paddingStart="14dp" />

            <TextView
                android:id="@+id/tvMobileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:text="Mobile Number"
                android:fontFamily="@font/actor"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/etprofilename"
                app:layout_constraintStart_toStartOf="parent" />


            <EditText
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:hint="Enter Mobile Number"
                android:inputType="phone"
                android:id="@+id/etprofilemob"
                android:maxLength="10"
                android:background="@drawable/edit_bg"
                android:textColor="@color/white"
                android:textColorHint="#BFFFFFFF"
                android:paddingStart="14dp" />


            <TextView
                android:id="@+id/tvEmailAddressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:text="Email Address"
                android:fontFamily="@font/actor"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/etprofilemob"
                app:layout_constraintStart_toStartOf="parent" />



            <EditText
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:hint="Enter Email Address"
                android:inputType="textEmailAddress"
                android:background="@drawable/edit_bg"
                android:textColor="@color/white"
                android:textColorHint="#BFFFFFFF"
                android:id="@+id/etprofileemailaddress"
                android:paddingStart="14dp" />


            <TextView
                android:id="@+id/tvPasswordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:text="Password"
                android:fontFamily="@font/actor"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/etprofileemailaddress"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:hint="Enter Password"
                android:inputType="textPassword"
                android:background="@drawable/edit_bg"
                android:textColor="@color/white"
                android:id="@+id/etprofilepassword"
                android:textColorHint="#BFFFFFFF"
                android:paddingStart="14dp" />

            <!-- USERNAME -->
            <TextView
                android:id="@+id/tvUsernameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:text="User Name"
                android:fontFamily="@font/actor"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/etprofilepassword"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:hint="Enter User Name"
                android:inputType="textMultiLine"
                android:background="@drawable/edit_bg"
                android:textColor="@color/white"
                android:textColorHint="#BFFFFFFF"
                android:paddingStart="14dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
